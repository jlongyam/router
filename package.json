{
  "name": "@jlbyte/router",
  "version": "2.0.1",
  "description": "A hash based router",
  "keywords": [
    "router",
    "hash"
  ],
  "homepage": "https://github.com/jlongyam/router",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jlongyam/router.git"
  },
  "license": "MIT",
  "author": "jlongyam",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "src/router.mjs",
  "module": "src/router.mjs",
  "types": "src/router.d.mts",
  "unpkg": "dist/router.js",
  "jsdelivr": "dist/router.js",
  "exports": {
    ".": {
      "types": "./src/router.d.mts",
      "import": "./src/router.mjs",
      "default": "./src/router.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepublishOnly": "node scripts/build.mjs",
    "test": "node scripts/build.mjs && uvu test",
    "typecheck": "tsc",
    "test:webkit": "node scripts/test-webkit.mjs",
    "start": "serve .",
    "usage:nw": "nw usage/nw"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@rollup/plugin-babel": "^7.1.0",
    "happy-dom": "^21.0.1",
    "nw": "0.78.0-sdk",
    "playwright": "1.64.1",
    "rollup": "^4.64.9",
    "serve": "^14.2.6",
    "typescript": "^7.0.2",
    "uvu": "^0.5.6"
  }
}
